{
  "metric": "eval_total",
  "direction": "higher",
  "baseline_score": 4.0,
  "alpha": 0.05,
  "min_samples": 8,
  "knobs": {
    "prompt_style": {
      "type": "category",
      "values": ["concise", "structured", "socratic"],
      "desc": "给 AI 的提示风格"
    },
    "temperature": {
      "type": "continuous",
      "range": [0.0, 1.0],
      "step": 0.1,
      "desc": "采样温度"
    },
    "self_eval_before_deliver": {
      "type": "category",
      "values": ["off", "on"],
      "desc": "交付前是否先自评"
    },
    "review_rounds": {
      "type": "discrete",
      "values": [0, 1, 2, 3],
      "desc": "交付前反思轮数"
    }
  },
  "constraints": [
    "prompt_style=socratic 时 review_rounds 必须 ≥ 1（否则无意义）",
    "temperature 与 review_rounds 不宜同时取极端（高温度+多轮易发散）"
  ]
}
